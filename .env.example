# API
BEECARGO_API_URL=http://localhost:3001
BEECARGO_API_KEY=

# Server
BEECARGO_MCP_TRANSPORT=stdio
PORT=3100
BEECARGO_MCP_PUBLIC_URL=http://localhost:3100
BEECARGO_MCP_BEARER_TOKEN=
# Set true to require transport bearer or bc_* on /mcp (production default: required unless explicitly false)
BEECARGO_MCP_REQUIRE_AUTH=false
BEECARGO_MCP_HOST=0.0.0.0
BEECARGO_MCP_ALLOWED_HOSTS=
BEECARGO_MCP_TRUST_PROXY=false
# Rightmost X-Forwarded-For hops trusted when BEECARGO_MCP_TRUST_PROXY=true (prefer CF-Connecting-IP).
BEECARGO_MCP_TRUSTED_PROXY_HOPS=1
BEECARGO_MCP_RATE_LIMIT_RPM=120
BEECARGO_MCP_MAX_SESSIONS=2000
BEECARGO_MCP_SESSION_TTL_MS=1800000
BEECARGO_MCP_MAX_BODY_BYTES=4194304

# Fetch: raise for large remote uploads (API streams; MCP may wait on sync remote_upload)
BEECARGO_API_FETCH_TIMEOUT_MS=300000
BEECARGO_API_FETCH_RETRIES=2

# OAuth (must match API when enabled; INTERNAL_API_KEY required for token introspection)
BEECARGO_MERCHANT_OAUTH_ENABLED=false
INTERNAL_API_KEY=
